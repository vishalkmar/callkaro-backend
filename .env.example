NODE_ENV=development
PORT=5000
PUBLIC_BASE_URL=https://api.yourapp.in        # used in provider webhooks (ngrok URL in dev)
# Neon (production): postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/callkaro?sslmode=require
# Local Docker:       postgresql://callkaro:callkaro@localhost:5434/callkaro
DATABASE_URL=postgresql://callkaro:callkaro@localhost:5434/callkaro
DB_POOL_MAX=10
CORS_ORIGINS=https://yourapp.in               # websites allowed to call the API (report form). App needs none.
TRUST_PROXY=1

JWT_ACCESS_SECRET=change_me_64_chars
JWT_REFRESH_SECRET=change_me_64_chars
JWT_ACCESS_TTL=30m
JWT_REFRESH_TTL=30d

# Brevo (email OTP)
BREVO_API_KEY=xkeysib-xxxxxxxx
BREVO_SENDER_EMAIL=no-reply@yourapp.in        # must be a verified sender in Brevo
BREVO_SENDER_NAME=CallingKaro
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15

# Voice provider (example: Twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxx                    # for webhook signature validation
TWILIO_TWIML_APP_SID=APxxxxxxxx
TWILIO_PUSH_CREDENTIAL_SID=                   # optional (only needed for incoming calls)
CALLER_ID_POOL=+91XXXXXXXXXX,+91YYYYYYYYYY    # numbers you own / verified - NEVER random numbers
REPORT_URL=yourapp.in/report
RECORDING_RETENTION_DAYS=7
CALL_METADATA_RETENTION_DAYS=365
SKIP_WEBHOOK_SIGNATURE=false                  # true ONLY for local curl testing; ignored in production

# Economy (server decides every amount)
CREDITS_PER_MINUTE=1000
MIN_CREDITS_TO_CALL=1000
WELCOME_BONUS_CREDITS=2000
AD_REWARD_CREDITS=250
MAX_AD_REWARDS_PER_DAY=20
MIN_SECONDS_BETWEEN_AD_REWARDS=30
MAX_EXTRA_SPINS_PER_DAY=5
FREE_SPIN_INTERVAL_HOURS=24
DAILY_CHECKIN_CREDITS=100
REFERRAL_BONUS_CREDITS=5000
# PACKAGES_JSON=[{"id":"minutes_80","priceInr":100,"minutes":80}]

# Abuse limits
MAX_CALLS_PER_HOUR=30
MAX_DISTINCT_NUMBERS_PER_DAY=50
MAX_CALLS_PER_NUMBER_PER_HOUR=3
REPORTS_TO_AUTOBLOCK=3
ACCOUNTS_PER_DEVICE=2
RING_TIMEOUT_SECONDS=45

# Payments
PAYMENT_PROVIDER=play                         # play | razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx
GOOGLE_PLAY_PACKAGE_NAME=com.callingkaro.app
GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/play.json
PLAY_RTDN_TOKEN=long_random_token

# Admin & monitoring
ADMIN_API_KEY=long_random_key
ADMIN_IP_ALLOWLIST=                            # comma separated IPs, empty = any
ALERT_WEBHOOK_URL=                             # Slack/Discord/Telegram webhook for alerts
DAILY_TELEPHONY_SPEND_ALERT_INR=2000
PROVIDER_COST_PAISE_PER_MIN=120

# AdMob rewarded unit id(s) allowed to pay out via SSV, e.g. ca-app-pub-123/4567890123 (comma separated)
ADMOB_REWARDED_AD_UNITS=

# Spin wheel prizes + relative weights (optional). Default: 5 (98%), 10 (2%), 20 (0%).
# SPIN_SEGMENTS_JSON=[{"label":"5","credits":5,"weight":98},{"label":"10","credits":10,"weight":2}]

# TESTING ONLY (never in production - the server refuses to start): print the OTP in the server console
# instead of emailing it. Keep false; real logins go through Brevo.
OTP_DEV_LOG=false

# Test / store-review login (optional): this ONE email always accepts DEMO_LOGIN_OTP, no email is sent.
# All other emails still use Brevo. Leave empty (or remove) to turn it off.
DEMO_LOGIN_EMAIL=
DEMO_LOGIN_OTP=

# ---------------- Telnyx (second calling provider) ----------------
# USE_TELNYX=true -> ALL new calls go through Telnyx (Twilio values above are then ignored).
# false / missing -> Twilio. Switch = change this + restart (Render: Manual Deploy). The app follows the server.
USE_TELNYX=false
# Mission Control > Account Settings > Keys & Credentials > API Keys (starts with KEY...)
TELNYX_API_KEY=
# Mission Control > Keys & Credentials > Public Key (base64) - verifies webhook signatures. Required in production.
TELNYX_PUBLIC_KEY=
# Voice > SIP Trunking > Credential Connection used by the app (WebRTC). Its id (numbers).
#   Webhook URL: https://<api>/voice/telnyx/webhook , API v2, Outbound: call parking ON + your outbound voice profile
TELNYX_CONNECTION_ID=
# Voice > Programmable Voice > Voice API Application used to dial the phone number. Its id.
#   Webhook URL: https://<api>/voice/telnyx/webhook , API v2, Outbound voice profile with India (+91) allowed
TELNYX_CALL_CONTROL_APP_ID=
# Telnyx numbers you own (E.164, comma separated) - shown as caller ID. Twilio numbers do NOT work here.
TELNYX_CALLER_ID_POOL=

# ---------------- Admin panel (/admin-panel) ----------------
# First admin is created from these on boot (once). Change the password later inside the panel.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Admin login codes (2FA by email) are sent here. The authenticator app can be added in Security.
ADMIN_2FA_EMAIL=
